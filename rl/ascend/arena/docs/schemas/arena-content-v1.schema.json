          "default": "ge",
          "enum": [
            "ge",
            "gt",
            "le",
            "lt",
            "eq",
            "ne"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "field",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "resource": {
          "default": "stamina",
          "enum": [
            "stamina",
            "penetrate",
            "concentration",
            "good_condition",
            "excellent_condition",
            "good_impression",
            "motivation",
            "full_power"
