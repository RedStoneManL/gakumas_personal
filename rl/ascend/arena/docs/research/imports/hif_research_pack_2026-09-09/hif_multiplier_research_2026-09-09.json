  "formula": {
    "L": "Piecewise linear interpolation of the selected color Permil column against that color stat",
    "A_percent": "ceil(100 + L / 10)",
    "B_internal_percent": "A_percent * dearness_factor",
    "B_display_percent": "ceil(B_internal_percent)",
    "K_above_baseline_permil": "min(3000, 2000 + ceil(1000 * (S - T) / D))",
    "final_display_percent": "ceil(B_internal_percent * K / 1000)",
    "battle_score_rounding": "Not identified by displayed percentages; retain unrounded values separately.",
    "low_star_EXPERIMENTAL_ONLY": "ceil(1850 + 150*S/T), 0<=S<T; assumption, not fitted",
    "cross_stat_penalty": "Uncalibrated HIF branch. Explicit settings-prior: q_i=floor(250-150*min(p_i/t_i,1))/1000 for observed triangle/cross, else 0; Q=1-sum(q_i). Candidate A=ceil(100+(L/10)*Q). Alternative: apply Q to whole A in A-to-B. Neither placement is HIF-validated."
  },
