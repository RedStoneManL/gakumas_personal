{
  "$defs": {
    "Audition": {
      "additionalProperties": false,
      "description": "Exact user-authored score-threshold stage, independent of official NPC estimates.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]*/[a-zA-Z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "turns": {
          "exclusiveMinimum": 0,
          "title": "Turns",
          "type": "integer"
        },
        "clear_score": {
          "minimum": 0,
          "title": "Clear Score",
          "type": "number"
        },
        "perfect_score": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perfect Score"
        },
        "weights": {
          "default": [
            1,
            1,
            1
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Weights",
          "type": "array"
        },
        "colors": {
          "default": [],
          "items": {
            "enum": [
              "vocal",
              "dance",
              "visual"
            ],
            "type": "string"
          },
          "title": "Colors",
          "type": "array"
        },
        "deck": {
          "items": {
            "$ref": "#/$defs/CardCopy"
          },
          "minItems": 1,
          "title": "Deck",
          "type": "array"
        },
        "drinks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Drinks",
          "type": "array"
        },
        "items": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Items",
          "type": "array"
        },
        "passives": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Passives",
          "type": "array"
        },
        "starting_stamina": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Starting Stamina",
          "type": "integer"
        },
        "max_stamina": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Max Stamina",
          "type": "integer"
        },
        "score_bonus": {
          "default": 1,
          "minimum": 0,
          "title": "Score Bonus",
          "type": "number"
        },
        "hand_limit": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Hand Limit",
          "type": "integer"
        },
        "turn_draw": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Turn Draw",
          "type": "integer"
        },
        "plays_per_turn": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Plays Per Turn",
          "type": "integer"
        },
        "hold_limit": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Hold Limit",
          "type": "integer"
        },
        "hold_overflow": {
          "default": "oldest",
          "enum": [
            "oldest",
            "choose"
          ],
          "title": "Hold Overflow",
          "type": "string"
        },
        "success_effects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowEffect"
          },
          "title": "Success Effects",
          "type": "array"
        },
        "failure_effects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowEffect"
          },
          "title": "Failure Effects",
          "type": "array"
        }
      },
      "required": [
        "id",
        "turns",
        "clear_score",
        "deck"
      ],
      "title": "Audition",
      "type": "object"
    },
    "Branch": {
