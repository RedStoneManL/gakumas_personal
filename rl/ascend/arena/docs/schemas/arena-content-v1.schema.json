        "upgrade": {
          "default": 0,
          "minimum": 0,
          "title": "Upgrade",
          "type": "integer"
        },
        "cost": {
          "$ref": "#/$defs/Cost"
        },
        "condition": {
          "default": "",
          "title": "Condition",
          "type": "string"
        },
        "effects": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/EffectUse"
              }
            ]
          },
          "title": "Effects",
          "type": "array"
        },
        "on_move": {
          "anyOf": [
            {
              "$ref": "#/$defs/MovementEffect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "after_play": {
          "default": "discard",
          "enum": [
            "discard",
            "exhaust",
            "hold",
            "deck_bottom"
          ],
          "title": "After Play",
          "type": "string"
        },
        "opening": {
          "default": false,
          "title": "Opening",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "Card",
      "type": "object"
    },
    "CardCopy": {
      "additionalProperties": false,
      "properties": {
        "card": {
          "title": "Card",
          "type": "string"
        },
        "upgrade": {
          "default": 0,
